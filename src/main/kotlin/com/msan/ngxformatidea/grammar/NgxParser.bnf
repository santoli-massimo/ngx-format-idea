{
  parserClass = "com.msan.ngxformatidea.grammar.NgxParser"
//  extends = "com.intellij.lang.parser.GeneratedParserUtilBase"
  extends = "com.intellij.extapi.psi.ASTWrapperPsiElement"

  psiClassPrefix="Ngx"
  psiImplClassSuffix="Impl"
  psiPackage="com.msan.ngxformatidea.psi"
  psiImplPackage="com.msan.ngxformatidea.psi.impl"

  elementTypeHolderClass="com.msan.ngxformatidea.psi.NgxTypes"
  elementTypeClass="com.msan.ngxformatidea.psi.NgxElementType"
  tokenTypeClass="com.msan.ngxformatidea.psi.NgxTokenType"

//  tokens = [
//    COMPONENT_START = "[component]"
//    COMPONENT_END = "[/component]"
//    TEXT = "regexp:[^\[$\\\s]+"
//    LINE_COMMENT = "//[^\\n]*"  // Single-line comment
//    BLOCK_COMMENT = "/\\*[^*]*\\*/"  // Multi-line comment
//    WHITE_SPACE = "regexp:[^\S\n]+"
//  ]
}

file ::= component

component ::= COMPONENT_START content? COMPONENT_END

content ::= TEXT+

comment ::= LINE_COMMENT | BLOCK_COMMENT

//text ::= TEXT
COMPONENT_START ::= "[component]"
COMPONENT_END ::= "[/component]"
//TEXT ::= "regexp:[^\[$\\\s]+"

TEXT ::= "[^\\[\\]\\n\\r]+"
WHITE_SPACE ::= "\\s+"
LINE_COMMENT ::= "//[^\\n]*"
BLOCK_COMMENT ::= "/\\*([^*]|\\*+[^*/])*\\*+/"
//COMPONENT ::= "[component]" (TEXT | TEXT | WHITE_SPACE | LINE_COMMENT | BLOCK_COMMENT)* "[/component]"


