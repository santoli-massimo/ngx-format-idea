<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN. It cannot be changed between the plugin versions. -->
    <id>com.msan.ngx-format-idea</id>

    <!-- Public plugin name should be written in Title Case.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/plugin-overview-page.html#plugin-name -->
    <name>Ngx Format</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor email="santoli.massimo@gmail.com" url="https://github.com/santoli-massimo">santoli-massimo</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Simple HTML elements (text formatting, paragraphs, and lists) can be added inside of <![CDATA[ ]]> tag.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/plugin-overview-page.html#plugin-description -->
    <description><![CDATA[
        <p>Experimental support for <code>.ngx</code> files — a single-file component format
        for Angular (template, style and component class in one file, Vue/Svelte style).</p>
        <p>Provides a custom language (JFlex lexer + Grammar-Kit parser), syntax highlighting,
        multi-host language injection (HTML/CSS/TypeScript inside blocks) and live sync
        with the standard Angular component files.</p>
  ]]></description>

    <!-- Product and plugin compatibility requirements. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>JavaScript</depends>
    <depends>com.intellij.modules.platform</depends>
    <depends>HtmlTools</depends>
    <depends>AngularJS</depends>


    <!-- Extension points defined by the plugin. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <!-- VFS -->
        <fileType
                name="Ngx File"
                implementationClass="com.msan.ngxformatidea.psi.NgxFileType"
                fieldName="INSTANCE"
                language="Ngx"
                extensions="ngx"
        />
        <treeStructureProvider implementation="com.msan.ngxformatidea.vfs.NgxTreeStructureProvider"/>

        <!-- LANG -->
        <multiHostInjector implementation="com.msan.ngxformatidea.injection.NgxMultiHostInjector"/>
        <lang.parserDefinition language="Ngx" implementationClass="com.msan.ngxformatidea.parser.NgxParserDefinition"/>
        <lang.syntaxHighlighterFactory language="Ngx" implementationClass="com.msan.ngxformatidea.highlighting.NgxSyntaxHighlighterFactory"/>

        <!-- ICONS -->
        <fileIconProvider implementation="com.msan.ngxformatidea.utils.NgxFileIconProvider"/>


        <!--        <lang.fileViewProviderFactory language="Ngx" implementationClass="com.msan.ngxformatidea.language.NgxFileViewProviderFactory"/>-->
    </extensions>
</idea-plugin>